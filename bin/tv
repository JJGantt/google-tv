#!/usr/bin/env python3
"""Control the Bedroom TV (TCL Google TV) over wireless adb.

Runs unchanged on the Mac and the Pi; each machine is paired with the TV
separately (see docs/SETUP.md). Every command prints what the TV reports
back, not what was requested, so a silent failure shows up as a wrong value.
"""
import os
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

# The TV's identity on the network. Its IP is DHCP and its adb port changes
# every time wireless debugging is re-enabled, so both are discovered by this
# name and cached; neither is ever written down.
GUID = "adb-D00650B30E80300FC-jOM1G6"
# The plain (non-TLS) adb service the TV also announces once `adb tcpip` has been run on it. Its TLS
# announcement can outlive the port it names (connection refused) while this one still answers, so
# discovery tries both.
GUID_PLAIN = GUID.rsplit("-", 1)[0]
# Per-machine settings kept outside the repo (docs/SETUP.md).
CONFIG = Path.home() / ".config" / "google-tv"
# Wake-on-LAN target: the wlan0 MAC (the TV has no wired connection), one line. It only wakes the TV
# when TCL's standby mode is Network standby; docs/POWER.md.
MAC_FILE = CONFIG / "mac"
NETWORK_STANDBY = "tcl_sys_network_standby_enabled"
STATE = Path.home() / ".cache" / "google-tv-addr"

# com.tcl.tv.display.ITvDisplayManagerService transaction codes (decompiled
# from /system_ext/framework/com.tcl.tv.display.jar; see docs/TCL-DISPLAY-SERVICE.md).
TX_SET_CONTRAST = 31
TX_GET_CONTRAST = 32
TX_SET_DYNAMIC_CONTRAST = 47
TX_GET_DYNAMIC_CONTRAST = 48
TX_SET_BACKLIGHT = 100
TX_GET_BACKLIGHT = 101
TX_GET_PICTURE_MODE = 27
TX_GET_SATURATION = 38
TX_GET_HUE = 34
TX_GET_COLOR_TEMPERATURE = 54
TX_GET_COLOR_SPACE = 73
TX_GET_LOW_BLUE = 109
# The codes are the AIDL's method order, so a firmware update that adds a method shifts them and a call
# lands on a different setting. They hold for the jar with this hash; any other refuses (display()).
DISPLAY_JAR = "/system_ext/framework/com.tcl.tv.display.jar"
DISPLAY_JAR_SHA256 = "c14f5ea2d1374ab5a6abeae0c6bbfa15a6a0129a12aad7908332c62fc44a4600"
WINDOW = 0
APPLY_CURRENT_MODE = 0
ACT_EXEC_SAVE = 2

INPUTS = {f"hdmi{n}": f"com.tcl.tvinput/.TvPassThroughService/HW{14 + n}" for n in range(1, 5)}

APPS = {
    "youtube": "com.google.android.youtube.tv",
    "netflix": "com.netflix.ninja",
    "prime": "com.amazon.amazonvideo.livingroom",
    "disney": "com.disney.disneyplus",
    "hulu": "com.hulu.livingroomplus",
    "max": "com.wbd.stream",
    "tubi": "com.tubitv",
    "appletv": "com.apple.atve.androidtv.appletv",
    "youtubemusic": "com.google.android.youtube.tvmusic",
    "youtubetv": "com.google.android.youtube.tvunplugged",
    "settings": "com.android.tv.settings",
}


def run(*args, check=True):
    p = subprocess.run(["adb", *args], capture_output=True, text=True, timeout=30)
    if check and p.returncode != 0:
        raise SystemExit(f"adb {' '.join(args)}: {p.stderr.strip() or p.stdout.strip()}")
    return p.stdout


def discover():
    """Candidate ip:ports from the TV's mDNS announcements, TLS first, then plain adb. The Mac's adb
    resolves mDNS itself; Debian's adb (the Pi) is built without it, so there it is avahi-browse."""
    found = []
    if Path("/usr/bin/avahi-browse").exists():
        for svc, name in (("_adb-tls-connect._tcp", GUID), ("_adb._tcp", GUID_PLAIN)):
            p = subprocess.run(["avahi-browse", "-rpt", svc], capture_output=True, text=True, timeout=10)
            for line in p.stdout.splitlines():
                f = line.split(";")
                if f[0] == "=" and f[2] == "IPv4" and f[3] == name:
                    found.append(f"{f[7]}:{f[8]}")
        return found
    out = run("mdns", "services", check=False)
    for svc, name in (("_adb-tls-connect._tcp", GUID), ("_adb._tcp", GUID_PLAIN)):
        found += re.findall(rf"^{re.escape(name)}\s+{re.escape(svc)}\s+([\d.]+:\d+)", out, re.M)
    return found


def serial():
    """Connect if needed and return the adb serial for the TV."""
    cached = STATE.read_text().strip() if STATE.exists() else None
    for addr in (cached, *discover()):
        if not addr:
            continue
        run("connect", addr, check=False)
        if run("-s", addr, "get-state", check=False).strip() == "device":
            STATE.parent.mkdir(parents=True, exist_ok=True)
            STATE.write_text(addr)
            return addr
    raise SystemExit("TV unreachable: wireless debugging is off, the TV is unplugged, or it is not on the network")


def sh(*cmd):
    return run("-s", serial(), "shell", *cmd)


def parcel_int(out):
    """`service call` prints 'Result: Parcel(00000000 0000001e ...)': status word, then the value."""
    words = re.findall(r"\b([0-9a-f]{8})\b", out)
    if len(words) < 2 or words[0] != "00000000":
        raise SystemExit(f"binder call failed: {out.strip()}")
    return int(words[1], 16)


_display_checked = False


def display(code, *args):
    """One tcl_tv_display call with int arguments; returns its int result."""
    global _display_checked
    if not _display_checked:
        got = sh("sha256sum", DISPLAY_JAR).split()[0]
        if got != DISPLAY_JAR_SHA256:
            raise SystemExit(f"{DISPLAY_JAR} has changed (firmware update?): the transaction codes may "
                             "have shifted. Re-derive them (docs/TCL-DISPLAY-SERVICE.md), then set "
                             f"DISPLAY_JAR_SHA256 = \"{got}\"")
        _display_checked = True
    return parcel_int(sh("service", "call", "tcl_tv_display", str(code), *[x for a in args for x in ("i32", str(a))]))


def picture(name, get_code, set_args, value=None, hi=100):
    if value is not None:
        v = int(value)
        if not 0 <= v <= hi:
            raise SystemExit(f"{name} is 0-{hi}")
        if not display(*set_args(v)):
            raise SystemExit(f"TV refused the {name} change")
    return display(*get_code)


def brightness(value=None):
    print(picture("brightness", (TX_GET_BACKLIGHT,),
                  lambda v: (TX_SET_BACKLIGHT, APPLY_CURRENT_MODE, v, ACT_EXEC_SAVE), value))


def contrast(value=None):
    print(picture("contrast", (TX_GET_CONTRAST, WINDOW),
                  lambda v: (TX_SET_CONTRAST, WINDOW, APPLY_CURRENT_MODE, v, ACT_EXEC_SAVE), value))


def dynamic_contrast(value=None):
    """0 off, 1 low, 2 high (the menu's Dynamic Contrast)."""
    print(picture("dynamic contrast", (TX_GET_DYNAMIC_CONTRAST, WINDOW),
                  lambda v: (TX_SET_DYNAMIC_CONTRAST, WINDOW, APPLY_CURRENT_MODE, v, ACT_EXEC_SAVE), value, hi=2))


# Raw values -> the menu's names, from the TV's own Settings app (com.tcl.settings EnPicture and
# com.tcl.tv.pq.EnColorTmpType; docs/TCL-DISPLAY-SERVICE.md § Values).
PICTURE_MODES = ["Standard", "Vivid", "Mild", "Studio", "Stadium", "Game", "Game vivid", "Game normal", "PC",
                 "SDR pro", "SDR AI adaptive", "Smart Q", "IMAX", "SDR IQ", "Filmmaker", "Photo"]
COLOR_TEMPS = ["Cool", "Standard", "Warm", "Personal", "Custom"]
COLOR_SPACES = ["Auto", "Native", "Custom", "3D LUT"]


def picture_settings(what=None):
    """No argument: the colour settings of the current input, by their menu names. `menu`: open the
    Picture panel on screen. PictureActivity only shows the panel when started with the
    DISPLAY_SETTINGS action; started bare it closes itself after half a second and shows nothing."""
    if what == "menu":
        sh("am", "start", "-a", "android.settings.DISPLAY_SETTINGS",
           "-n", "com.android.tv.settings/com.tcl.settings.PictureActivity")
        print("opened")
        return
    if what is not None:
        raise SystemExit("picture [menu]")
    name = lambda names, i: names[i] if 0 <= i < len(names) else f"unknown ({i})"
    mode = display(TX_GET_PICTURE_MODE)
    print("picture mode", "FILMMAKER MODE" if mode == 60 else name(PICTURE_MODES, mode))
    print("blue light filter", "on" if display(TX_GET_LOW_BLUE, WINDOW) else "off")
    print("colour temperature", name(COLOR_TEMPS, display(TX_GET_COLOR_TEMPERATURE, WINDOW)))
    print("colour space", name(COLOR_SPACES, display(TX_GET_COLOR_SPACE, WINDOW)))
    print("saturation", display(TX_GET_SATURATION, WINDOW))
    print("hue", display(TX_GET_HUE, WINDOW))
    print("brightness", display(TX_GET_BACKLIGHT))
    print("contrast", display(TX_GET_CONTRAST, WINDOW))


# The settings he chose for watching in bed on 2026-10-30.
NIGHT = {"brightness": 0, "contrast": 60, "dynamic_contrast": 0}


def night():
    """The dim picture for watching in bed, in one step; prints what the TV reports for each."""
    for name, value in NIGHT.items():
        print(name, end=" ")
        globals()[name](value)


def get_volume():
    out = sh("cmd", "media_session", "volume", "--stream", "3", "--get")
    return int(re.search(r"volume is (\d+)", out).group(1))


def volume(value=None):
    """TCL's audio ignores `media_session volume --set` (the call succeeds and the
    level does not move), so a target is reached one volume key at a time."""
    if value is not None:
        target = int(value)
        if not 0 <= target <= 100:
            raise SystemExit("volume is 0-100")
        cur = get_volume()
        while cur != target:
            sh("input", "keyevent", "KEYCODE_VOLUME_UP" if target > cur else "KEYCODE_VOLUME_DOWN")
            nxt = get_volume()
            if nxt == cur:
                raise SystemExit(f"volume stuck at {cur}")
            cur = nxt
    print(get_volume())


def is_on():
    m = re.search(r"mWakefulness=(\w+)", sh("dumpsys", "power"))
    return bool(m and m.group(1) == "Awake")


def wake():
    """Wake-on-LAN magic packet. The fastest wake (under a second) and needs no adb; harmless when on."""
    if not MAC_FILE.exists():
        raise SystemExit(f"no TV MAC at {MAC_FILE}")
    mac = MAC_FILE.read_text().strip()
    pkt = bytes.fromhex("ff" * 6 + mac.replace(":", "") * 16)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for port in (9, 7):
            s.sendto(pkt, ("255.255.255.255", port))


def power(state=None):
    """on: Wake-on-LAN, then adb's KEYCODE_WAKEUP if the TV is still off a few seconds later.
    off: KEYCODE_SLEEP. Prints the state the TV reports afterwards."""
    if state == "on":
        # One packet is not always enough after hours in standby (docs/POWER.md), so it is resent
        # every second until the TV reports Awake.
        for _ in range(5):
            wake()
            time.sleep(1)
            if is_on():
                break
        else:
            sh("input", "keyevent", "KEYCODE_WAKEUP")
            time.sleep(1)
    elif state == "off":
        # Remote power-on needs Network standby, the one mode that keeps Wi-Fi up in standby
        # (docs/POWER.md). Choosing another mode in the TV's menu turns it off with no sign, so it is
        # put back before every sleep and said so.
        if sh("settings", "get", "system", NETWORK_STANDBY).strip() != "1":
            sh("settings", "put", "system", NETWORK_STANDBY, "1")
            print("network standby was off; turned it back on", file=sys.stderr)
        sh("input", "keyevent", "KEYCODE_SLEEP")
        time.sleep(1)
    elif state is not None:
        raise SystemExit("power on|off")
    print("on" if is_on() else "off")


# The sleep timer is a one-shot systemd timer in the user manager, so it outlives the process that set it
# (data-http restarts on every pull). systemd, so Linux only: the Pi's (docs/POWER.md § Sleep timer).
SLEEP_UNIT = "bedroom-tv-sleep"
OPS = Path.home() / "repos" / "health" / "responder" / "bin" / "ops"


def _user_systemd(*cmd, check=True):
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    return subprocess.run(cmd, env=env, capture_output=True, text=True, check=check).stdout


def _sleep_at():
    """The local time the pending sleep fires, or None."""
    out = _user_systemd("systemctl", "--user", "show", f"{SLEEP_UNIT}.timer",
                        "-p", "ActiveState", "-p", "Description", check=False)
    props = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    if props.get("ActiveState") != "active":
        return None
    return props.get("Description", "").removeprefix("bedroom TV off at ") or None


def sleep_timer(arg=None):
    """sleep <minutes>: turn the TV off that many minutes from now, replacing any pending one.
    sleep off: cancel it. sleep: print when it fires, or "none". Prints the time it fires afterwards."""
    if arg is None:
        print(_sleep_at() or "none")
        return
    if arg == "fire":
        # The timer's own run. The outcome is the TV off, not the key sent, so it is checked and a TV
        # still on is reported to the ops responder.
        power("off")
        if is_on():
            subprocess.run([str(OPS), "error", SLEEP_UNIT, "sleep timer fired but the TV is still on"], check=False)
            raise SystemExit("the TV is still on")
        return
    _user_systemd("systemctl", "--user", "stop", f"{SLEEP_UNIT}.timer", check=False)
    _user_systemd("systemctl", "--user", "reset-failed", f"{SLEEP_UNIT}.service", check=False)
    if arg == "off":
        print("none")
        return
    minutes = float(arg)
    if not 0 < minutes <= 24 * 60:
        raise SystemExit("sleep <minutes 1-1440>|off")
    at = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time() + minutes * 60))
    _user_systemd("systemd-run", "--user", f"--unit={SLEEP_UNIT}", f"--on-calendar={at}",
                  "--timer-property=AccuracySec=1s", f"--description=bedroom TV off at {at}",
                  str(Path(__file__).resolve()), "sleep", "fire")
    print(_sleep_at() or "none")


def now():
    """Foreground app and the active media session, if any."""
    focus = re.search(r"mCurrentFocus=Window\{\S+ \S+ ([^}/ ]+)", sh("dumpsys", "window"))
    print("app:", focus.group(1) if focus else "?")
    # Each session lists package=, then state=PlaybackState {...}, then metadata.
    pkg = st = None
    for line in sh("dumpsys", "media_session").splitlines():
        if m := re.search(r"\bpackage=(\S+)", line):
            pkg, st = m.group(1), None
        elif m := re.search(r"state=PlaybackState \{state=(\w+)", line):
            st = m.group(1)
        elif (m := re.search(r"metadata: .*description=(.+)", line)) and st in ("PLAYING", "PAUSED", "BUFFERING"):
            print(f"media: {pkg} {st} {m.group(1)}")


def open_url(url, app=None):
    # An intent: URI (the catalog's Android TV deep links) is a whole intent; am takes it as is.
    cmd = ["am", "start", "-W", f"'{url}'"] if url.startswith("intent:") else ["am", "start", "-W", "-a", "android.intent.action.VIEW", "-d", url]
    if app:
        cmd.append(APPS.get(app, app))
    print(sh(*cmd).strip().splitlines()[-1])


def launch(app):
    print(sh("monkey", "-p", APPS.get(app, app), "-c", "android.intent.category.LEANBACK_LAUNCHER", "1").strip().splitlines()[-1])


def input_(name):
    if name not in INPUTS:
        raise SystemExit(f"input is one of {', '.join(INPUTS)}")
    uri = "content://android.media.tv/passthrough/" + INPUTS[name].replace("/", "%2F")
    open_url(uri)


# `select` means the remote's OK button, DPAD_CENTER. KEYCODE_SELECT is a different key that Prime
# Video ignores, so the literal mapping leaves its profile picker sitting there.
KEY_ALIASES = {"select": "DPAD_CENTER", "ok": "DPAD_CENTER"}


def key(*names):
    names = [KEY_ALIASES.get(n.lower(), n) for n in names]
    sh("input", "keyevent", *[n if n.isdigit() or n.startswith("KEYCODE_") else f"KEYCODE_{n.upper()}" for n in names])


def text(s):
    sh("input", "text", s.replace(" ", "%s"))


def screen():
    """Text on screen with each element's centre, and which element has focus."""
    sh("uiautomator", "dump", "/sdcard/ui.xml")
    xml = sh("cat", "/sdcard/ui.xml")
    for node in re.findall(r"<node [^>]*>", xml):
        label = re.search(r'text="([^"]+)"', node) or re.search(r'content-desc="([^"]+)"', node)
        if not label:
            continue
        x1, y1, x2, y2 = map(int, re.search(r'bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"', node).groups())
        mark = "*" if 'focused="true"' in node else " "
        print(f"{mark} {(x1 + x2) // 2:>4},{(y1 + y2) // 2:<4} {label.group(1)}")


def screenshot(path="tv.png"):
    s = serial()
    run("-s", s, "shell", "screencap", "-p", "/sdcard/tv-shot.png")
    run("-s", s, "pull", "/sdcard/tv-shot.png", path)
    print(path)


# "Who's watching?" as tesseract reads it off a downscaled screenshot (the apostrophe comes and goes).
PICKER = re.compile(r"who.{0,2}s\s+watching", re.I)


def foreground():
    m = re.search(r"mCurrentFocus=Window\{\S+ \S+ ([^}/ ]+)", sh("dumpsys", "window"))
    return m.group(1) if m else None


def screen_text():
    """(text, black): what tesseract reads on screen now. A protected surface (DRM playback, an HDMI
    input) captures as solid black, which is told apart from a screen that merely has no text."""
    from PIL import Image
    import io
    png = subprocess.run(["adb", "-s", serial(), "exec-out", "screencap", "-p"], capture_output=True, timeout=30).stdout
    im = Image.open(io.BytesIO(png)).convert("L")
    im = im.resize((960, im.height * 960 // im.width))
    if im.getextrema()[1] < 16:
        return "", True
    buf = io.BytesIO()
    im.save(buf, "PNG")
    ocr = subprocess.run(["tesseract", "stdin", "stdout"], input=buf.getvalue(), capture_output=True, timeout=30)
    return ocr.stdout.decode(errors="replace"), False


def profile(app="prime", seconds="20"):
    """Get past APP's "Who's watching?" profile picker after it was opened: OK picks the highlighted
    profile, which is the last one used, and the app carries on into the link it was given. The picker
    has no accessibility tree and logs nothing, so it is found by reading the screen; this looks for at
    most `seconds`, and stops early once the app shows a page with text on it that is not the picker.
    Exits non-zero if the picker is still up after OK, or if every look was a blank capture."""
    pkg = APPS.get(app, app)
    end = time.time() + float(seconds)
    looks = blank = 0
    while time.time() < end:
        if foreground() != pkg:
            time.sleep(1)
            continue
        txt, black = screen_text()
        looks += 1
        blank += black
        if PICKER.search(txt):
            key("select")
            time.sleep(3)
            if PICKER.search(screen_text()[0]):
                raise SystemExit("the profile picker is still showing after OK")
            print("picked the profile")
            return
        if len(re.sub(r"\s", "", txt)) > 40:
            print("no profile picker")
            return
        time.sleep(1)
    if looks and blank == looks:
        raise SystemExit(f"{app}: every screenshot was blank, so the picker cannot be seen")
    print(f"no profile picker ({app} {'never came to the front' if not looks else 'showed no page'} in {seconds}s)")


APP = "com.jaredgantt.tvcompanion"
# The hub's device token, kept per machine outside the repo and pushed into the app on demand.
HUB_TOKEN_FILE = CONFIG / "hub-token"


def sidebar(state="on", width=None):
    """The focused session in a see-through strip down the right (docs/CAPABILITIES.md § Sidebar).
    `token` pushes this machine's hub token into the app; `on` does that too, so it is never stale."""
    if state in ("on", "token"):
        if not HUB_TOKEN_FILE.exists():
            raise SystemExit(f"no hub token at {HUB_TOKEN_FILE}")
        sh("am", "broadcast", "-n", f"{APP}/.ConfigReceiver", "--es", "hub_token", HUB_TOKEN_FILE.read_text().strip())
    if state == "on":
        extra = ["--ef", "width", str(float(width))] if width else []
        sh("am", "start-foreground-service", "-n", f"{APP}/.SidebarService", "-a", "show", *extra)
    elif state == "off":
        sh("am", "start-foreground-service", "-n", f"{APP}/.SidebarService", "-a", "hide")
    elif state != "token":
        raise SystemExit("sidebar on [width 0-1]|off|token")
    print(state)


def link():
    """(Re)start the app's connection to the hub that voice control rides (docs/VOICE.md)."""
    sh("am", "start-foreground-service", "-n", f"{APP}/.TvLink")
    print("started")


def overlay(text_, seconds="5"):
    """A line of text in the top right corner over whatever is on screen, for `seconds`."""
    sh("am", "start-foreground-service", "-n", f"{APP}/.OverlayService",
       "--es", "text", text_, "--ei", "seconds", str(int(seconds)))


COMMANDS = {
    "brightness": brightness, "contrast": contrast, "dynamic-contrast": dynamic_contrast, "night": night,
    "picture": picture_settings,
    "volume": volume, "power": power, "wake": wake, "now": now, "sleep": sleep_timer,
    "open": open_url, "launch": launch, "input": input_, "key": key, "text": text,
    "screen": screen, "screenshot": screenshot, "profile": profile, "sidebar": sidebar, "overlay": overlay, "link": link,
    "shell": lambda *c: print(sh(*c), end=""),
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        raise SystemExit("usage: tv " + "|".join(COMMANDS) + " [args]")
    COMMANDS[sys.argv[1]](*sys.argv[2:])
